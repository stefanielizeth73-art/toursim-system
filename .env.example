# Copy this file to .env and fill in your local values.
# Do not commit .env.

SECRET_KEY=change-me
AMAP_JS_KEY=your_js_key
AMAP_SECURITY_JS_CODE=your_js_security_code
AMAP_WEB_KEY=your_web_key
AI_ASSISTANT_ENABLED=1
AI_PROVIDER=deepseek
AI_MODEL=deepseek-v4-pro
AI_REASONING_MODEL=deepseek-v4-pro
AI_BASE_URL=https://api.deepseek.com
AI_ROUTER_MODE=fast
AI_THINKING=disabled
AI_REASONING_EFFORT=low
DEEPSEEK_API_KEY=your_deepseek_api_key
# Optional: switch AI_PROVIDER=openai and set OPENAI_API_KEY to use OpenAI.
OPENAI_API_KEY=
DASHSCOPE_API_KEY=your_bailian_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_VIDEO_MODEL=wan2.7-i2v-2026-04-25
DIARY_VIDEO_DEFAULT_DURATION=5
DIARY_VIDEO_DEFAULT_RESOLUTION=720P
FLASK_HOST=127.0.0.1
FLASK_PORT=5005
FLASK_DEBUG=1
